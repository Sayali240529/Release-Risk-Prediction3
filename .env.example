# ==============================================================================
# Release-Risk Prediction Platform - Environment Configuration
# ==============================================================================

# Server Network Configuration
# On Render / cloud hosts, PORT is automatically injected by the platform.
PORT=8080
HOST=0.0.0.0
ENVIRONMENT=production

# GitHub Personal Access Token (Optional, recommended for high volume PR queries)
# Leave blank to use public unauthenticated rate limits (60 req/hr) + raw diff fallback.
# Set a GitHub PAT (classic or fine-grained) to increase rate limits to 5,000 req/hr.
GITHUB_TOKEN=

